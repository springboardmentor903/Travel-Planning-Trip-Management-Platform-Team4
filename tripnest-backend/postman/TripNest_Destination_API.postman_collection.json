{
	"info": {
		"_postman_id": "d3e4f5a6-7890-12bc-def3-3456789012cd",
		"name": "TripNest - Destination API Collection",
		"description": "Dedicated Postman collection for testing Destination and Weather endpoints in the TripNest platform.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
