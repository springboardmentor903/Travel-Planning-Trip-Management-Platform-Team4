# =========================================================
# TripNest Platform — Production Environment Configuration
# =========================================================

# ---------------------------------------------------------
# Spring Boot Backend Environment Variables
# ---------------------------------------------------------
# Active Spring Profile (Use 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://your-production-db-host:5432/tripnestdb
DB_USERNAME=your_production_db_username
DB_PASSWORD=your_secure_production_db_password

# Database DDL Mode (Use 'validate' in production with database migrations)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Authentication Security (Supply a 256-bit cryptographically random secret string)
# Example generation: openssl rand -base64 32
JWT_SECRET=your_production_cryptographically_strong_256bit_secret_string
JWT_EXPIRATION=86400000

# Weather API Integration
WEATHER_API_KEY=your_openweather_api_key

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Initial Production Administrator Bootstrap Credentials (Optional)
ADMIN_INITIAL_EMAIL=admin@your-domain.com
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password

# CORS Security (Comma-separated list of allowed production frontend origins)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ---------------------------------------------------------
# Next.js Frontend Environment Variables
# ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com/api
